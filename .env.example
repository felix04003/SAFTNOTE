# ═══════════════════════════════════════════════════════
#  EcoleManager — Variables d'environnement (racine)
#  Copier ce fichier en .env et remplir les valeurs
# ═══════════════════════════════════════════════════════

# Environnement
NODE_ENV=development

# Base de données PostgreSQL
POSTGRES_USER=ecolemanager
POSTGRES_PASSWORD=changeme_secret
POSTGRES_DB=ecolemanager_dev

# Redis
REDIS_PASSWORD=changeme_redis
