# ═══════════════════════════════════════════════════════════════
#  EcoleManager Backend — Variables d'environnement PRODUCTION
#
#  USAGE :
#    cp backend/.env.production.example .env.production
#    nano .env.production        # Remplir TOUTES les valeurs
#    chmod 600 .env.production   # Lecture seule propriétaire
#
#  SECURITE :
#    - Ne jamais committer ce fichier
#    - Ne jamais utiliser les valeurs de développement en prod
#    - Générer des secrets forts avec les commandes ci-dessous
#    - Stocker ce fichier hors du dépôt git (ex: Hetzner Cloud Console)
#
#  GENERATION DES SECRETS :
#    JWT_SECRET :
#      node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#    POSTGRES_PASSWORD / REDIS_PASSWORD :
#      openssl rand -base64 32
#    MONITORING_TOKEN :
#      openssl rand -hex 24
#    MEDICAL_ENCRYPTION_KEY :
#      node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ═══════════════════════════════════════════════════════════════

# ── Environnement ────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
API_PREFIX=/api/v1

# ── Base de données PostgreSQL ───────────────────────────────────
# Le mot de passe doit contenir min. 24 caractères aléatoires
POSTGRES_USER=ecolemanager
POSTGRES_PASSWORD=REMPLACER_MOT_DE_PASSE_FORT_32_CHARS
POSTGRES_DB=ecolemanager_prod

# URL construite à partir des variables ci-dessus
# Dans docker-compose.prod.yml, l'API utilise le service "postgres"
DATABASE_URL=postgresql://ecolemanager:REMPLACER_MOT_DE_PASSE_FORT_32_CHARS@postgres:5432/ecolemanager_prod
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20

# ── Redis ────────────────────────────────────────────────────────
REDIS_PASSWORD=REMPLACER_MOT_DE_PASSE_REDIS_24_CHARS
REDIS_URL=redis://:REMPLACER_MOT_DE_PASSE_REDIS_24_CHARS@redis:6379

# ── JWT ──────────────────────────────────────────────────────────
# Minimum 64 caractères hexadécimaux — à générer avec openssl/crypto
JWT_SECRET=REMPLACER_PAR_128_CHARS_HEXADECIMAUX_ALEATOIRES
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# ── OTP SMS ──────────────────────────────────────────────────────
OTP_EXPIRES_MINUTES=10
OTP_LENGTH=6

# ── Africa's Talking (SMS) ───────────────────────────────────────
# Créer un compte sur https://africastalking.com
# En prod, utiliser le vrai username (pas "sandbox")
AT_API_KEY=REMPLACER_PAR_VOTRE_CLE_API_AFRICAS_TALKING
AT_USERNAME=REMPLACER_PAR_VOTRE_USERNAME_AFRICAS_TALKING
AT_SENDER_ID=EcoleManager

# ── WhatsApp Meta Business API (optionnel, phase 2) ─────────────
# Créer une app sur https://developers.facebook.com
# Laisser vide si non configuré — les notifs basculent sur SMS
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_WA_VERIFY_TOKEN=

# Plages horaires pour les notifications (format HH:MM)
NOTIF_HEURE_DEBUT=07:00
NOTIF_HEURE_FIN=21:00

# ── Cloudflare R2 (stockage bulletins PDF) ───────────────────────
# Créer un bucket sur https://dash.cloudflare.com
# Gratuit jusqu'à 10 Go de stockage
R2_ACCOUNT_ID=REMPLACER_PAR_VOTRE_ACCOUNT_ID_CLOUDFLARE
R2_ACCESS_KEY_ID=REMPLACER_PAR_VOTRE_R2_ACCESS_KEY
R2_SECRET_ACCESS_KEY=REMPLACER_PAR_VOTRE_R2_SECRET_KEY
R2_BUCKET_NAME=ecolemanager-bulletins
R2_PUBLIC_URL=https://bulletins.VOTRE-DOMAINE.com

# ── Sécurité ─────────────────────────────────────────────────────
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
# Lister toutes les origines autorisées (dashboard + app mobile Expo)
CORS_ORIGINS=https://VOTRE-DOMAINE.com,https://dashboard.VOTRE-DOMAINE.com

# ── Chiffrement données médicales ─────────────────────────────────
# Clé AES-256 — 64 caractères hex — JAMAIS perdre cette clé
MEDICAL_ENCRYPTION_KEY=REMPLACER_PAR_64_CHARS_HEX_ALEATOIRES

# ── Monitoring ───────────────────────────────────────────────────
# Token Bearer pour protéger GET /health/deep et GET /metrics
MONITORING_TOKEN=REMPLACER_PAR_TOKEN_ALEATOIRE_48_CHARS
# Numéro SMS pour recevoir les alertes critiques
ADMIN_PHONE=+221XXXXXXXXX
MONITORING_INTERVAL_MS=120000
MONITORING_COOLDOWN_MS=900000

# ── Logs ─────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=json

# ── Frontend / CORS ──────────────────────────────────────────────
FRONTEND_URL=https://VOTRE-DOMAINE.com

# ── Performance ──────────────────────────────────────────────────
SLOW_REQUEST_MS=2000

# ── Rate limiting fins ───────────────────────────────────────────
RATE_LIMIT_GLOBAL_MAX=200
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_REGISTER_MAX=3

# ── Workers BullMQ ───────────────────────────────────────────────
WORKER_MOYENNES_CONCURRENCE=2
WORKER_BULLETINS_CONCURRENCE=1

# ── Docker Compose (utilisé dans docker-compose.prod.yml) ────────
IMAGE_TAG=latest
NGINX_DOMAIN=api.VOTRE-DOMAINE.com
