# ═══════════════════════════════════════════════════════
#  EcoleManager Backend — Variables d'environnement
#  Copier ce fichier en .env et remplir les valeurs
# ═══════════════════════════════════════════════════════

# Serveur
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# Base de données PostgreSQL
DATABASE_URL=postgresql://ecolemanager:changeme_secret@localhost:5432/ecolemanager_dev
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ── RLS phase 1 pilote (migration 019) — rôle non propriétaire ecole_app_rls ──
# Utilisé uniquement par backend/src/infrastructure/database/rls.js
# (avecContexteEtablissement) et la route pilote GET /configs/matieres.
# Ne JAMAIS mettre le vrai secret ici. Positionner le mot de passe réel
# du rôle séparément, jamais via un fichier committé :
#   ALTER ROLE ecole_app_rls WITH PASSWORD '<secret réel>';
# Option A (prioritaire, même style que DATABASE_URL) :
DATABASE_URL_RLS=postgresql://ecole_app_rls:changeme_rls_secret@localhost:5432/ecolemanager_dev
# Option B (si DATABASE_URL_RLS absent) : réutilise host/port/db des
# variables POSTGRES_HOST/POSTGRES_PORT/POSTGRES_DB (voir backend/.env),
# seuls user/password diffèrent :
POSTGRES_RLS_USER=ecole_app_rls
POSTGRES_RLS_PASSWORD=changeme_rls_secret

# Redis (cache + file BullMQ)
REDIS_URL=redis://:changeme_redis@localhost:6379

# JWT — Générer avec: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=remplacer_par_64_caracteres_aleatoires_minimum
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# OTP SMS (durée et longueur du code)
OTP_EXPIRES_MINUTES=10
OTP_LENGTH=6

# ── SMS : Africa's Talking ───────────────────────────
AT_API_KEY=votre_cle_api_africas_talking
AT_USERNAME=sandbox             # "sandbox" en dev, votre username en prod
AT_SENDER_ID=EcoleManager       # Identifiant expéditeur (opt selon pays)

# ── WhatsApp : Meta Business API ────────────────────
META_WA_TOKEN=votre_token_meta_whatsapp_business
META_WA_PHONE_NUMBER_ID=votre_phone_number_id
META_WA_VERIFY_TOKEN=votre_webhook_verify_token

# Notifications — plages horaires (format HH:MM)
NOTIF_HEURE_DEBUT=07:00
NOTIF_HEURE_FIN=21:00

# ── Stockage fichiers (bulletins PDF) ───────────────
# Cloudflare R2 ou AWS S3 (API S3-compatible)
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_ACCESS_KEY=votre_access_key_id
S3_SECRET_KEY=votre_secret_access_key
S3_BUCKET=ecolemanager-bulletins

# Option B : AWS S3 (même variables que R2)
# AWS_REGION=eu-west-1

# ── Sécurité ─────────────────────────────────────────
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000     # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ── Logs ─────────────────────────────────────────────
LOG_LEVEL=debug                 # debug | info | warn | error
LOG_FORMAT=pretty               # pretty | json (json en prod)
LOG_TO_FILE=false               # true pour écrire aussi logs/error.log et logs/combined.log (déconseillé sur filesystem éphémère : Render/Docker sans volume)

# ── Monitoring ────────────────────────────────────────────────────
MONITORING_TOKEN=               # Token Bearer pour protéger /health/deep et /metrics
ADMIN_PHONE=                    # Numéro pour alertes SMS ex: +221770000000
MONITORING_INTERVAL_MS=120000   # Intervalle de vérification (ms) — défaut: 2 min
MONITORING_COOLDOWN_MS=900000   # Anti-spam: min. délai entre 2 alertes (ms) — défaut: 15 min

# ── Chiffrement données médicales (pgcrypto AES-256) ─────────────
# Générer avec: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MEDICAL_ENCRYPTION_KEY=remplacer_par_64_caracteres_hex_aleatoires

# ── CORS & Frontend ───────────────────────────────────────────────
FRONTEND_URL=http://localhost:3001  # Virgule pour plusieurs origines

# ── Performance ───────────────────────────────────────────────────
SLOW_REQUEST_MS=2000               # Seuil alerte requêtes lentes (ms)

# ── Rate limiting ─────────────────────────────────────────────────
RATE_LIMIT_GLOBAL_MAX=100          # Requêtes/minute sur PREFIX global
RATE_LIMIT_AUTH_MAX=10             # Tentatives connexion / 15 min
RATE_LIMIT_REGISTER_MAX=5          # Créations établissement / heure

# ── Proxy ────────────────────────────────────────────────────────
# Nombre de sauts de proxy devant l'app (Express "trust proxy").
# 1 derrière un seul reverse proxy (Nginx local, load balancer Render).
# Sans ce réglage, req.ip = IP du proxy et le rate limiting est partagé
# par tous les utilisateurs.
TRUST_PROXY_HOPS=1

# ── Workers BullMQ ───────────────────────────────────────────────
WORKER_MOYENNES_CONCURRENCE=2      # Jobs moyennes en parallèle
WORKER_BULLETINS_CONCURRENCE=1     # Jobs PDF Puppeteer (garder à 1)

# ── Infra / Déploiement ───────────────────────────────────────────
NGINX_DOMAIN=ecolemanager.example.com   # Domaine pour TLS Nginx
MIGRATIONS_DIR=                         # Chemin abs vers migrations/ (optionnel)
